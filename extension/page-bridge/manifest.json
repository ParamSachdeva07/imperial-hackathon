{
  "manifest_version": 3,
  "name": "Desktop Assistant Page Bridge",
  "version": "0.2.2",
  "description": "Lets the Desktop Assistant app on this Mac read and act on the page in the active tab. It talks only to the app on 127.0.0.1.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Desktop Assistant Page Bridge: click to reconnect"
  }
}
