{
  "name": "@pointy/gestures",
  "version": "0.1.0",
  "description": "Hand-gesture interpreter for Pointy (MediaPipe landmarks -> wake/point/region events)",
  "main": "src/index.ts",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fetch-model": "node scripts/fetch-model.mjs",
    "mouse-bridge": "node scripts/mouse-bridge.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./detector": "./src/detector.ts"
  },
  "optionalDependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6"
  }
}
