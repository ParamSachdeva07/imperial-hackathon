{
  "name": "pointy",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*",
    "backend/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev -w @pointy/desktop",
    "broker": "npm run start -w @pointy/explainer-broker",
    "gen:tools": "tsx packages/shared/scripts/export-tools.ts",
    "pregen": "tsx scripts/pregen-demo-images.ts",
    "postinstall": "node node_modules/electron/install.js",
    "voice": "npm run build -w @pointy/desktop && cd apps/desktop && POINTY_VOICE=1 npx electron .",
    "app": "npm run build -w @pointy/desktop && cd apps/desktop && npx electron ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
