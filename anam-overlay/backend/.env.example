# Synthesia interactive avatar. With SYNTHESIA_API_KEY set it is used instead of Anam (AVATAR_PROVIDER=anam
# switches back). Synthesia renders the avatar into a LiveKit room of yours, so a LiveKit Cloud project is needed.
# The avatar id is the "Interactive ID" (starts with av_) from Synthesia's Avatars page.
SYNTHESIA_API_KEY=
SYNTHESIA_AVATAR_ID=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
