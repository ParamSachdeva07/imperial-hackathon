{
  "name": "anam-overlay-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "npm run build:electron && node scripts/dev.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "start": "node scripts/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:backend": "backend/.venv/bin/python -m pytest backend/tests -q"
  },
  "dependencies": {
    "@anam-ai/js-sdk": "^4.29.2",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
