# Keep this file on the backend. Never put this key in Electron or VITE_*.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# OpenAI plans/reviews the persistent task; Jev chooses each observed action.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# The development launcher creates DECISION_API_TOKEN automatically.

# Speed-first supervisor. Ultrafast has higher token rates.
OPENAI_REASONING_EFFORT=low
OPENAI_SERVICE_TIER=ultrafast
# Economical alternative: gpt-6-luna, effort none, blank service tier.

# Provider selection; each key is sent only to its matching provider.
SUPERVISOR_PROVIDER=openai
# To switch, set SUPERVISOR_PROVIDER=cerebras and supply this key.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b
CEREBRAS_REASONING_EFFORT=low

# qwen-3.8-27b supports reasoning none; gpt-oss-120b does not.

# Optional task-coordinator overrides. Omit to share the planner model/configuration.
# ORCHESTRATOR_PROVIDER=openai
# ORCHESTRATOR_MODEL=gpt-6-luna
# ORCHESTRATOR_REASONING_EFFORT=none
# ORCHESTRATOR_SERVICE_TIER=
