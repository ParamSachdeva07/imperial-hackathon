# Keep this file on the backend. Never put these keys in Electron or VITE_*.
# The development launcher creates DECISION_API_TOKEN automatically.

# Navigator: the fast model that takes one step at a time.
NAVIGATOR_PROVIDER=cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b
CEREBRAS_REASONING_EFFORT=low

# Luna, the orchestrator: plans the task and decides when it is finished.
ORCHESTRATOR_PROVIDER=openai
OPENAI_API_KEY=
ORCHESTRATOR_MODEL=gpt-6-luna
ORCHESTRATOR_REASONING_EFFORT=none
ORCHESTRATOR_SERVICE_TIER=priority
