new file mode 100644
index 0000000..95d06ef
--- /dev/null
+++ b/crates/macos/src/tree/properties/range_text.rs
@@ -0,0 +1,93 @@
+use super::{ax_ipc, bounded_string::BoundedString};
+use crate::tree::{AXElement, observation_usage::ObservationUsage};
+use accessibility_sys::{
+    AXValueCreate, kAXErrorCannotComplete, kAXErrorFailure,
+    kAXErrorParameterizedAttributeUnsupported, kAXErrorSuccess, kAXValueTypeCFRange,
+};
+use core_foundation::{
+    base::{CFType, TCFType},
+    number::CFNumber,
+    string::CFString,
+};
+use core_foundation_sys::base::CFRange;
+
+pub(crate) fn eligible(role: Option<&str>, subrole: Option<&str>) -> bool {
+    matches!(role, Some("AXTextField" | "AXTextArea" | "AXComboBox"))
+        && subrole != Some("AXSecureTextField")
+}
+
+fn count(element: &AXElement, deadline: impl ax_ipc::AxDeadline) -> Result<Option<usize>, i32> {
+    let name = CFString::new("AXNumberOfCharacters");
+    let (error, raw) = ax_ipc::copy_attribute_value(element, name.as_concrete_TypeRef(), deadline);
+    let value = (!raw.is_null()).then(|| unsafe { CFType::wrap_under_create_rule(raw) });
+    if error != kAXErrorSuccess {
+        return if super::ax_absence::is_absent_attribute_error(error)
+            || error == kAXErrorParameterizedAttributeUnsupported
+        {
+            Ok(None)
+        } else {
+            Err(error)
+        };
+    }
+    let number = value
+        .and_then(|v| v.downcast::<CFNumber>())
+        .and_then(|n| n.to_i64());
+    number
+        .and_then(|n| usize::try_from(n).ok())
+        .map(Some)
+        .ok_or(kAXErrorFailure)
+}
+
+pub(crate) fn read(
+    element: &AXElement,
+    deadline: impl ax_ipc::AxDeadline,
+    usage: &mut ObservationUsage,
+) -> Result<Option<BoundedString>, i32> {
+    let Some(length) = count(element, deadline)? else {
+        return Ok(None);
+    };
+    if length > usage.string_capacity() {
+        return Ok(Some(BoundedString {
+            value: String::new(),
+            complete: false,
+        }));
+    }
+    let range = CFRange::init(0, length as isize);
+    let parameter =
+        unsafe { AXValueCreate(kAXValueTypeCFRange, (&range as *const CFRange).cast()) };
+    if parameter.is_null() {
+        return Err(kAXErrorFailure);
+    }
+    let parameter = unsafe { CFType::wrap_under_create_rule(parameter.cast()) };
+    let name = CFString::new("AXStringForRange");
+    let (error, raw) = ax_ipc::copy_parameterized_attribute_value(
+        element,
+        name.as_concrete_TypeRef(),
+        parameter.as_CFTypeRef(),
+        deadline,
+    );
+    let value = (!raw.is_null()).then(|| unsafe { CFType::wrap_under_create_rule(raw) });
+    if error != kAXErrorSuccess {
+        return if super::ax_absence::is_absent_attribute_error(error)
+            || error == kAXErrorParameterizedAttributeUnsupported
+        {
+            Ok(None)
+        } else {
+            Err(error)
+        };
+    }
+    let text = value
+        .and_then(|v| v.downcast::<CFString>())
+        .ok_or(kAXErrorFailure)?;
+    let text = BoundedString::from_cf(&text, usage).map_err(|_| kAXErrorFailure)?;
+    if count(element, deadline)? != Some(length)
+        || text.complete && text.value.encode_utf16().count() != length
+    {
+        return Err(kAXErrorCannotComplete);
+    }
+    Ok(Some(text))
+}
+
+#[cfg(test)]
+#[path = "range_text_tests.rs"]
+mod tests;
