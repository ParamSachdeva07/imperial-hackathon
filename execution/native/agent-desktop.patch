+pub(crate) fn offscreen_from_attrs(attrs: &NodeAttrs, parent: Option<Rect>) -> Option<bool> {
+    let viewport = super::element_bounds::surface_viewport(
+        parent,
+        attrs.role.as_deref().unwrap_or(""),
+        attrs.bounds,
+    );
+    offscreen(attrs.bounds, viewport)
+}
