+use super::*;
+use rustc_hash::FxHashSet;
+
+#[test]
+fn auxiliary_layers_require_an_exact_accessibility_window_identity() {
+    let pids = FxHashSet::from_iter([42]);
+    let ids = FxHashSet::from_iter([73]);
+    let scope = WindowRecordScope::Accessible {
+        pids: &pids,
+        ids: &ids,
+    };
+    assert!(scope.matches(42, 73));
+    assert!(!scope.matches(43, 73));
+    assert!(scope.includes_layer(3, 73));
+    assert!(!scope.includes_layer(3, 74));
+    assert!(scope.includes_layer(0, 74));
+    assert!(!WindowRecordScope::Pid(42).includes_layer(3, 73));
+    assert!(!WindowRecordScope::Pids(&pids).includes_layer(3, 73));
+    assert!(WindowRecordScope::Window(73).includes_layer(3, 73));
+    assert!(!WindowRecordScope::Window(73).includes_layer(3, 74));
+}
