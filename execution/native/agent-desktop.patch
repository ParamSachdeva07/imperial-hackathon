+#[derive(Clone, Copy)]
+pub(crate) enum WindowRecordScope<'a> {
+    Pid(i32),
+    Pids(&'a rustc_hash::FxHashSet<i32>),
+    Window(i64),
+    Accessible {
+        pids: &'a rustc_hash::FxHashSet<i32>,
+        ids: &'a rustc_hash::FxHashSet<i64>,
+    },
+}
+
+impl WindowRecordScope<'_> {
+    pub(super) fn includes_layer(self, layer: i64, window_number: i64) -> bool {
+        layer == 0
+            || match self {
+                Self::Window(expected) => expected == window_number,
+                Self::Accessible { ids, .. } => ids.contains(&window_number),
+                _ => false,
+            }
+    }
+
+    pub(super) fn matches(self, pid: i32, window_number: i64) -> bool {
+        match self {
+            Self::Pid(expected) => pid == expected,
+            Self::Pids(expected) => expected.contains(&pid),
+            Self::Accessible { pids, .. } => pids.contains(&pid),
+            Self::Window(expected) => window_number == expected,
+        }
+    }
+}
+
