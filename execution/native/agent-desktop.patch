+#[test]
+fn live_clipping_and_snapshot_clipping_agree_for_popup_and_regular_branches() {
+    let window = Some(rect(0.0, 500.0));
+    let popup = Some(rect(450.0, 200.0));
+    for outer_role in ["AXMenu", "AXPopover", "AXScrollArea", "AXGroup"] {
+        let chain = [
+            ("AXScrollArea", Some(rect(480.0, 100.0))),
+            (outer_role, popup),
+            ("AXWindow", window),
+        ];
+        let snapshot = chain.iter().rev().fold(window, |viewport, (role, bounds)| {
+            clipped_viewport(viewport, role, *bounds)
+        });
+        assert_eq!(
+            read_ancestor_chain(window, &chain),
+            snapshot,
+            "{outer_role}"
+        );
+    }
+}
