+fn popup_state_uses_its_own_surface_and_preserves_explicit_hidden_state() {
+    let el = AXElement(std::ptr::null_mut());
+    for native_role in ["AXMenu", "AXPopover"] {
+        let mut attrs = sample_attrs();
+        attrs.role = Some(native_role.into());
+        attrs.bounds = Some(Rect {
+            x: 200.0,
+            y: 200.0,
+            width: 100.0,
+            height: 400.0,
+        });
