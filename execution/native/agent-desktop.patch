+    let empty = clipped_viewport(
+        Some(rect(0.0, 100.0)),
+        "AXScrollArea",
+        Some(rect(200.0, 100.0)),
+    );
+    assert_eq!(
+        crate::tree::state_reader::offscreen(Some(rect(-50.0, 500.0)), empty),
+        Some(true)
+    );
+    let nested = clipped_viewport(empty, "AXScrollArea", Some(rect(-50.0, 500.0)));
+    assert_eq!(
