+fn read_ancestor_chain(window: Option<Rect>, chain: &[(&str, Option<Rect>)]) -> Option<Rect> {
+    ancestor_viewport_with(
+        window,
+        (!chain.is_empty()).then_some(0),
+        |index| Ok(Some(chain[*index].0.into())),
+        |index| Ok(chain[*index].1),
+        |index| Ok((*index + 1 < chain.len()).then_some(*index + 1)),
+    )
+    .unwrap()
+}
+
+#[test]
+fn live_popup_ancestry_retains_inner_scroll_clipping_and_stops_before_outer_scroll() {
+    let scroll = Rect {
+        x: 204.0,
+        y: 200.0,
+        width: 71.0,
+        height: 90.0,
+    };
+    for role in ["AXMenu", "AXPopover"] {
+        let chain = [("AXScrollArea", Some(scroll)), (role, Some(popup_bounds()))];
+        let viewport = ancestor_viewport_with(
+            Some(rect(0.0, 1000.0)),
+            Some(0),
+            |index| Ok(Some(chain[*index].0.into())),
+            |index| Ok(chain[*index].1),
+            |index| {
+                assert_eq!(
+                    *index, 0,
+                    "a popup must stop before reading its outer parent"
+                );
+                Ok(Some(*index + 1))
+            },
+        )
+        .unwrap();
+        assert_eq!(viewport, Some(scroll));
+        assert_eq!(
+            crate::tree::state_reader::offscreen(Some(Rect { y: 300.0, ..scroll }), viewport),
+            Some(true)
+        );
+    }
+}
